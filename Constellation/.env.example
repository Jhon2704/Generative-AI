# ═══════════════════════════════════════════════════════════════
# CONSTELLATION — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ═══════════════════════════════════════════════════════════════

# ── Anthropic (Claude) ───────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────
# Encontrarás estas valores en: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service key solo para migraciones/admin (no usar en frontend)
SUPABASE_SERVICE_KEY=

# ── Ollama (modelos open source locales) ─────────────────────
# Inicia Ollama con: ollama serve
# Descarga modelos con: ollama pull mistral && ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434

# ── Reflex ───────────────────────────────────────────────────
# Solo necesario para deploy en Reflex Cloud
# REFLEX_DEPLOY_TOKEN=...
